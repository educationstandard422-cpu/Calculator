#:import dp kivy.metrics.dp
<Calculator>:
    orientation: "vertical"
    padding: dp(10)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: (0.06,0.07,0.09,1) if root.dark else (0.95,0.95,0.95,1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(90)
        padding: dp(12)
        TextInput:
            text: root.result
            readonly: True
            halign: "right"
            font_size: dp(32)
            background_color: (0.11,0.12,0.15,1) if root.dark else (1,1,1,1)
            foreground_color: (1,1,1,1) if root.dark else (0.05,0.05,0.05,1)

    GridLayout:
        cols: 5
        spacing: dp(5)
        size_hint_y: None
        height: dp(150)
        Button:
            text: "sin"
            on_release: root.press(self.text)
        Button:
            text: "cos"
            on_release: root.press(self.text)
        Button:
            text: "tan"
            on_release: root.press(self.text)
        Button:
            text: "log"
            on_release: root.press(self.text)
        Button:
            text: "ln"
            on_release: root.press(self.text)
        Button:
            text: "√"
            on_release: root.press(self.text)
        Button:
            text: "x²"
            on_release: root.press(self.text)
        Button:
            text: "xʸ"
            on_release: root.press(self.text)
        Button:
            text: "π"
            on_release: root.press(self.text)
        Button:
            text: "e"
            on_release: root.press(self.text)
        Button:
            text: "("
            on_release: root.press(self.text)
        Button:
            text: ")"
            on_release: root.press(self.text)
        Button:
            text: "!"
            on_release: root.press(self.text)
        Button:
            text: "Ans"
            on_release: root.press(self.text)
        Button:
            text: "⌫"
            on_release: root.press(self.text)

    GridLayout:
        cols: 4
        spacing: dp(5)
        Button:
            text: "AC"
            on_release: root.press(self.text)
        Button:
            text: "±"
            on_release: root.press(self.text)
        Button:
            text: "%"
            on_release: root.press(self.text)
        Button:
            text: "÷"
            on_release: root.press(self.text)
        Button:
            text: "7"
            on_release: root.press(self.text)
        Button:
            text: "8"
            on_release: root.press(self.text)
        Button:
            text: "9"
            on_release: root.press(self.text)
        Button:
            text: "×"
            on_release: root.press(self.text)
        Button:
            text: "4"
            on_release: root.press(self.text)
        Button:
            text: "5"
            on_release: root.press(self.text)
        Button:
            text: "6"
            on_release: root.press(self.text)
        Button:
            text: "−"
            on_release: root.press(self.text)
        Button:
            text: "1"
            on_release: root.press(self.text)
        Button:
            text: "2"
            on_release: root.press(self.text)
        Button:
            text: "3"
            on_release: root.press(self.text)
        Button:
            text: "+"
            on_release: root.press(self.text)
        Button:
            text: "0"
            on_release: root.press(self.text)
        Button:
            text: "."
            on_release: root.press(self.text)
        Button:
            text: "="
            on_release: root.press(self.text)
        Button:
            text: "THEME"
            on_release: root.press(self.text)

    GridLayout:
        cols: 4
        size_hint_y: None
        height: dp(55)
        spacing: dp(5)
        Button:
            text: "M+"
            on_release: root.press(self.text)
        Button:
            text: "M-"
            on_release: root.press(self.text)
        Button:
            text: "MR"
            on_release: root.press(self.text)
        Button:
            text: "MC"
            on_release: root.press(self.text)
